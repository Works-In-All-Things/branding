{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://works-in-all-things.github.io/branding/schemas/brand-kit.schema.json",
  "title": "Works In All Things Brand Kit",
  "description": "Machine-readable source of truth for the Works In All Things brand.",
  "type": "object",
  "required": ["$schema", "version", "base_url", "brand", "tagline", "locations", "color_system", "radius", "typography", "logos", "brand_elements", "voice", "rules", "proposed_fields"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}$" },
    "base_url": { "type": "string", "format": "uri" },
    "brand": {
      "type": "object",
      "required": ["name", "website", "positioning"],
      "properties": {
        "name": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "positioning": { "type": "string" }
      },
      "additionalProperties": true
    },
    "tagline": { "$ref": "#/$defs/proposedValue" },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "status"],
        "properties": { "type": { "type": "string" }, "status": { "enum": ["confirmed", "proposed"] } },
        "additionalProperties": true
      }
    },
    "locations_status": { "enum": ["confirmed", "proposed"] },
    "locations_note": { "type": "string" },
    "color_system": {
      "type": "object",
      "required": ["palette", "interface", "semantic"],
      "properties": {
        "palette": { "type": "object", "additionalProperties": { "$ref": "#/$defs/paletteColor" } },
        "interface": { "type": "object" },
        "semantic": { "type": "object" }
      }
    },
    "radius": { "type": "object", "additionalProperties": { "$ref": "#/$defs/token" } },
    "typography": { "type": "object" },
    "logos": {
      "type": "object",
      "required": ["lockups", "rules"],
      "properties": { "lockups": { "type": "array" }, "rules": { "type": "array" } }
    },
    "brand_elements": { "type": "object" },
    "voice": { "type": "object" },
    "rules": { "type": "array", "items": { "type": "object", "required": ["kind", "instruction"], "properties": { "kind": { "enum": ["do", "dont"] }, "instruction": { "type": "string" } } } },
    "proposed_fields": { "type": "array", "items": { "$ref": "#/$defs/proposedField" } }
  },
  "$defs": {
    "proposedValue": { "type": "object", "required": ["value", "status"], "properties": { "value": { "type": ["string", "null"] }, "status": { "enum": ["confirmed", "proposed"] }, "note": { "type": "string" } } },
    "paletteColor": { "type": "object", "required": ["name", "tones", "text_on"], "properties": { "name": { "type": "string" }, "tones": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "hex", "status"], "properties": { "name": { "type": "string" }, "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }, "status": { "enum": ["confirmed", "proposed"] } } } }, "text_on": { "type": "object" } } },
    "token": { "type": "object", "required": ["value", "usage"], "properties": { "value": { "type": "string" }, "usage": { "type": "string" }, "status": { "enum": ["confirmed", "proposed"] } } },
    "proposedField": { "type": "object", "required": ["field", "status", "confirmation_needed"], "properties": { "field": { "type": "string" }, "status": { "const": "proposed" }, "confirmation_needed": { "type": "string" } } }
  },
  "additionalProperties": false
}
